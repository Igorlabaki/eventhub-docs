  logoUrl varchar [null]
  minimumPrice float [default: 0, null]
  whatsappNumber varchar [null]
  tiktokUrl varchar [null]
  instagramUrl varchar [null]
  street varchar [not null]
  streetNumber varchar [not null]
  complement varchar [null]
  neighborhood varchar [not null]
  city varchar [not null]
  state varchar [not null]
  checkIn varchar [default: '12:00', null]
  checkOut varchar [default: '12:00', null]
  openingHour varchar [null]
  closingHour varchar [null]
  cep varchar [not null]
  hasOvernightStay boolean [not null]
  minimumNights int [default: 1, null]
  createdAt datetime [default: `now()`, not null]
  organizationId varchar [not null, ref: > organization.id]
  pricingModel PricingModel [not null]
  pricePerPerson float [null]
  pricePerDay float [null]
  pricePerPersonDay float [null]
  pricePerPersonHour float [null]
  standardEventDuration int [null]
  maxGuest int [not null]
  Note: 'Prisma @default(uuid()) em id. Relação 1:1 com tiered_price via tiered_price.venueId'
}

Table tiered_price {
  id varchar [pk]
